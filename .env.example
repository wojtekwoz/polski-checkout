# ---------------------------------------------------------------
# polski-checkout - copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------

# Stripe (required). Use test keys (sk_test_...) until you are ready.
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (whsec_...), from Stripe Dashboard or `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Public URL of this app (used for Stripe success/cancel URLs). On Vercel it is detected automatically.
APP_URL=http://localhost:3000

# UI
NEXT_PUBLIC_SHOP_NAME=Mój sklep
NEXT_PUBLIC_DEFAULT_LOCALE=pl
NEXT_PUBLIC_TERMS_URL=

# Products: optional JSON override of products.config.ts, e.g.
# PRODUCTS_JSON=[{"id":"kurs","name":"Kurs","pricePln":199,"mode":"payment","stripePriceId":"price_..."}]
PRODUCTS_JSON=

# Company lookup. The MF VAT White List needs no key.
# Optional GUS BIR (REGON) fallback for companies not on the White List.
# Get a free key: https://api.stat.gov.pl/Home/RegonApi  (set GUS_ENV=test to use the GUS test environment)
GUS_API_KEY=
GUS_ENV=

# After payment: grant access by POSTing JSON to this URL (Zapier/Make/n8n catch hook, your LMS...)
ACCESS_WEBHOOK_URL=
# Optional: HMAC-SHA256 secret, sent as X-Polski-Checkout-Signature: sha256=<hex>
ACCESS_WEBHOOK_SECRET=

# After payment: invoicing. none | fakturownia | ifirma
INVOICING_PROVIDER=none
# company = only buyers who ticked "Chcę fakturę na firmę"; all = everyone
INVOICE_SCOPE=company

# Fakturownia (https://app.fakturownia.pl/api)
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=
# vat (faktura VAT) | bill (rachunek, for VAT-exempt sellers)
FAKTUROWNIA_KIND=vat
FAKTUROWNIA_SEND_EMAIL=false

# iFirma (https://api.ifirma.pl) - login + "faktura" API key (hex)
IFIRMA_LOGIN=
IFIRMA_INVOICE_KEY=
IFIRMA_PLACE_OF_ISSUE=
